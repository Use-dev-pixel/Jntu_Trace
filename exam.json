        {"id": "H4", "input": "5\n-1 -1 -2 -2 -3", "expectedOutput": "-2", "hidden": true},
        {"id": "H5", "input": "6\n0 0 10 10 5 5", "expectedOutput": "5", "hidden": true}
      ]
